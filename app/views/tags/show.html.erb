<p style="color: green"><%= notice %></p>

<%= render @tag%>

<div>
  <%= link_to "Edit this tag", edit_tag_path(@tag) %> |
  <%= link_to "Back to tags", tags_path, data:{e2e: "back-to-tags-show"} %>

  <%= button_to "Destroy this tag", @tag, method: :delete, data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'}, data: {e2e: 'delete-tag'}%>
</div>
